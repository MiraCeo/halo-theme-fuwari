---
import Categories from "./Categories.astro";
import MusicPlayer from "./MusicPlayer.astro";
import Profile from "./Profile.astro";
import Tags from "./Tags.astro";

interface Props {
  class?: string;
}

const className = Astro.props.class;
---

<aside id="sidebar" class:list={[className, "w-full"]}>
  <div class="mb-4 flex w-full flex-col gap-4">
    <Profile />
  </div>
  <div
    id="sidebar-sticky"
    class="sticky top-4 flex w-full flex-col gap-4 transition-all duration-700"
  >
    <div
      class="contents"
      th:each="widget, widgetStat : ${theme.config.sidebar.widgets}"
    >
      <div class="contents" th:switch="${widget.value}">
        <div class="contents" th:case="'categories'">
          <Categories class="onload-animation" />
        </div>
        <div class="contents" th:case="'tag'">
          <Tags class="onload-animation" />
        </div>
        <div
          th:case="'html'"
          class="card-base onload-animation p-4"
          th:utext="${widget.html}"
        >
        </div>
      </div>
    </div>

    <!--
      Music is a site-wide feature (see the 音乐 settings group), not a sidebar
      widget, so it renders once here rather than from the widget list above.
      It is rendered whenever music is enabled even if the sidebar panel is
      hidden: the player is the single owner of the <audio> element, and the
      top-bar button drives it through window.__fuwariMusic. The wrapper is what
      hides the panel, so the player itself keeps running.
    -->
    <div
      th:if="${theme.config.music != null and theme.config.music.enable}"
      th:style="${theme.config.music.show_sidebar != null and theme.config.music.show_sidebar} ? null : 'display: none'"
    >
      <MusicPlayer class="onload-animation" title="音乐" />
    </div>
  </div>
</aside>
